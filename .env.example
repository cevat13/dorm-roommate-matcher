# Copy to .env and adjust. Every value is optional; defaults live in
# src/roommate_matcher/config.py.

# --- Security (MUST be set in production) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RM_JWT_SECRET=change-me-before-deploying
RM_JWT_EXPIRE_MINUTES=1440

# --- Storage ---
# SQLite by default. For PostgreSQL:
# RM_DATABASE_URL=postgresql+psycopg://dorm:dorm@localhost:5432/dorm
# RM_DATABASE_URL=sqlite:///./data/dormitory.db

# --- Compatibility scoring ---
RM_DEFAULT_METRIC=weighted_gower
RM_DEFAULT_TOP_N=10

# --- Assignment ---
RM_DEFAULT_STRATEGY=optimal
# Beds per room. Fixed at two: the optimal solver is a graph matching.
RM_ROOM_CAPACITY=2
# Search the resulting plan for blocking pairs as a diagnostic.
RM_CHECK_STABILITY=true

# --- Synthetic data ---
RM_SYNTHETIC_STUDENT_COUNT=400
RM_RANDOM_SEED=42

# --- Logging ---
RM_LOG_LEVEL=INFO
RM_LOG_JSON=false

# --- API ---
RM_CORS_ORIGINS=["http://localhost:5173","http://localhost:8501"]
